{
  "name": "heraldic-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "npm run build && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "news:generate": "node --env-file=.env scripts/generate-news.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@aws-sdk/client-secrets-manager": "3.1142.0",
    "fast-xml-parser": "5.11.1"
  }
}
